# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Runtime data — contains customer PII (name, company, email, phone).
# Must never be committed to repository history.
/var/

# Local project archives. A zip of this working tree carries both a full copy
# of .git and whatever sits in var/, so committing one would leak enquiry data
# into history — and at ~200MB it would block the deploy anyway.
*.zip

.vercel
.env*
